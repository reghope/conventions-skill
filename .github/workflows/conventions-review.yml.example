# Daily read-only convention-drift review.
#
# This file is inert until renamed to conventions-review.yml. To enable it,
# pick one agent CLI below and provide the secret it needs. The review never
# writes to the repository: it reports stale or contradicted rules and a
# proposed curation as a GitHub issue, for a later user-approved run.
name: Conventions review
on:
  schedule:
    - cron: "17 6 * * *"
  workflow_dispatch:
permissions:
  contents: read
  issues: write
jobs:
  review:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      # Option A: Claude Code (needs ANTHROPIC_API_KEY secret)
      - name: Run curator in scheduled review mode
        env:
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
        run: |
          npm install -g @anthropic-ai/claude-code
          claude -p "Follow .github/skills/conventions-curator/SKILL.md in scheduled review mode: read-only. Report stale or contradicted rules in the managed repo-conventions block of AGENTS.md, the evidence, and a concise proposed curation. Do not modify any file." > review.md

      # Option B: Copilot CLI (replace the step above; needs a Copilot-enabled token)
      # - name: Run curator in scheduled review mode
      #   env:
      #     GH_TOKEN: ${{ secrets.COPILOT_CLI_TOKEN }}
      #   run: |
      #     npm install -g @github/copilot
      #     copilot -p "Use the conventions-curator skill in scheduled review mode: read-only. Report stale or contradicted rules, evidence, and a proposed curation. Do not modify any file." > review.md

      - name: Open issue with findings
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          gh issue create \
            --title "Conventions review $(date -u +%F)" \
            --body-file review.md
